<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A bare, dark, action-bar-less theme. All real styling happens in Compose
        (see ui/theme/Theme.kt); this only controls the window itself so there
        is no white flash before the first frame and the system bars are
        transparent for the edge-to-edge layout.
    -->
    <style name="Theme.LockScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
